{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "angular"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://staysync-backend-huuu.onrender.com/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
